build --compilation_mode=opt
build --enable_platform_specific_config
build:linux --cxxopt=-std=c++20
build:macos --cxxopt=-std=c++20
build:windows --cxxopt=/std:c++20
build:mingw --noenable_platform_specific_config
build:mingw --host_platform=//:mingw_x64
build:mingw --platforms=//:mingw_x64
build:mingw --extra_execution_platforms=//:mingw_x64
build:mingw --extra_toolchains=@local_config_cc//:cc-toolchain-x64_windows_mingw
build:mingw --cxxopt=-std=c++20
build:mingw --linkopt=-static
test --test_output=errors

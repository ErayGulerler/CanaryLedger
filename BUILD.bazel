load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "gate",
    srcs = ["src/gate.cpp"],
    hdrs = ["include/canary/gate.hpp"],
    includes = ["include"],
)

cc_binary(
    name = "canaryledger",
    srcs = ["src/main.cpp"],
    deps = [":gate"],
)

cc_test(
    name = "gate_test",
    size = "small",
    srcs = ["tests/gate_test.cpp"],
    deps = [":gate"],
)

platform(
    name = "mingw_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@rules_cc//cc/private/toolchain:mingw",
    ],
)

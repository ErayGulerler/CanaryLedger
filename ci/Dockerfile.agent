FROM jenkins/inbound-agent:jdk21

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates cmake curl g++ git ninja-build python3 \
    && rm -rf /var/lib/apt/lists/*
ARG BAZEL_VERSION=8.4.2
ARG BAZEL_SHA256=4dc8e99dfa802e252dac176d08201fd15c542ae78c448c8a89974b6f387c282c
RUN curl --fail --silent --show-error --location \
        "https://releases.bazel.build/${BAZEL_VERSION}/release/bazel-${BAZEL_VERSION}-linux-x86_64" \
        -o /usr/local/bin/bazel \
    && echo "${BAZEL_SHA256}  /usr/local/bin/bazel" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/bazel \
    && cmake --version && g++ --version && bazel --version
USER jenkins
